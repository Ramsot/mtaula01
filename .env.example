# Mtaula 01 WhatsApp Bot - Environment Variables
# Copy this file to .env and fill in your values

# Required: WhatsApp Session ID (leave blank for pairing code on first run)
SESSION_ID=

# Required: Bot Owner's WhatsApp Number (with country code, no +)
# Example: 2547XXXXXXXX for Kenya, 1XXXXXXXXXX for US
OWNER_NUMBER=

# Required: Bot Owner's Name
OWNER_NAME=Mtaula 01

# Required: Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_KEY=

# Optional: Bot Mode (public/private)
MODE=public

# Optional: Command Prefix
PREFIX=.

# Optional: Bot Display Name
BOT_NAME=Mtaula 01

# Optional: Bot Description
DESCRIPTION=Mtaula 01 WhatsApp Bot

# Optional: Menu Image URL
MENU_IMAGE=https://files.catbox.moe/7l1rr5.jpg

# Optional: Timezone (default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# Feature Flags
AUTO_STATUS_SEEN=true
AUTO_STATUS_REPLY=false
STATUS_READ_MSG=Status Seen By Mtaula 01
AUTO_READ_MESSAGES=false
AUTO_TYPING=false
AUTO_RECORDING=false
ALWAYS_ONLINE=false
AUTO_REACT=false
AUTO_BLOCK=true
AUTO_REJECT_CALLS=false
WELCOME=false

# Group Features
ADMIN_LOG_GROUP=
NOTIFY_ADMIN_CHANGES=true
SEND_RULES_DM=false
AUTO_MUTE_SUSPICIOUS=false
UPDATE_GROUP_STATS=true
NOTIFY_BOT_ADMIN_STATUS=false
CACHE_BOT_ADMIN_STATUS=true
BACKUP_GROUP_DATA=false

# Debug
DEBUG_MODE=false
LOG_ALL_EVENTS=false

# Render/Deployment
NODE_ENV=production
PORT=3000