# Copy to .env and fill in. NEVER commit the real .env file.

# --- Core ---
PREFIX=.
MODE=public
OWNER_NAME=Mtaula 01
OWNER_NUMBER=
# Extra comma-separated numbers allowed to run owner commands
OWNERS=
BOT_NAME=Mtaula 01
BOT_IMAGE=https://files.catbox.moe/7l1rr5.jpg
DESCRIPTION=Mtaula 01 WhatsApp Bot
TIMEZONE=Africa/Dar_es_Salaam
SESSION_DIR=./auth_info_baileys
# Persistent directory for admin accounts + device pairings. Keep it on the same
# mounted Disk as SESSION_DIR so redeploys don't wipe logins/pairings.
DATA_DIR=./data
PORT=3000

# --- AI keys (at least one is recommended) ---
GEMINI_KEY=
GROQ_KEY=
OPENAI_KEY=
OPENAI_MODEL=gpt-4o-mini
META_AI_TOKEN=
# WhatsApp number used for the Meta AI fallback engine (optional)
META_AI_NUMBER=867051314767696

# --- Web security ---
# Required for remote /api/reset and /api/pair calls (Authorization: Bearer <token>).
# If left empty, those endpoints only accept loopback requests.
ADMIN_TOKEN=

# --- Behaviour flags (true/false) ---
ALWAYS_ONLINE=false
AUTO_READ=false
AUTO_TYPING=false
AUTO_RECORDING=false
AUTO_REACT=false
REJECT_CALL=true
WELCOME=false
GOODBYE=false
ANTILINK=true
DEBUG_MODE=false
